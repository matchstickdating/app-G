# Match Stick — Environment Configuration Template
# Duplicate this file to .env for local development

# Supabase Project Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_for_admin_and_edge_functions

# AI Configuration (Backend / Edge Function Secrets only — never expose in mobile client)
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key

# Mobile App Environment
APP_ENV=development
